<Application x:Class="AirportSmith.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AirportSmith"
             xmlns:helpers="clr-namespace:AirportSmith.Helpers"
            >
    <Application.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:Point2DToPointConverter x:Key="Point2DToPoint"/>
        <helpers:Point2DListToPointCollectionConverter x:Key="Point2DListToPointCollection"/>
    </Application.Resources>
</Application>
