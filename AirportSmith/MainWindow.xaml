<Window x:Class="AirportSmith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AirportSmith.Controls"
        xmlns:inspector="clr-namespace:AirportSmith.Models.Inspector"
        xmlns:helpers="clr-namespace:AirportSmith.Helpers"
        Title="AirportSmith"
        Height="700" Width="1100"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="ICAO:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding IcaoInput, UpdateSourceTrigger=PropertyChanged}" Width="80" VerticalContentAlignment="Center"/>
            <Button Content="Load Airport" Command="{Binding LoadCommand}" Margin="10,0,0,0" Padding="10,2"/>
            <TextBlock Text="Loading..." Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Margin="20,0,0,0" VerticalAlignment="Center">
                <Run Text="Sim: "/>
                <Run Text="{Binding IsConnected, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Export Debug Data" Command="{Binding ExportDebugDataCommand}" Margin="20,0,0,0" Padding="10,2"
                    Visibility="{Binding IsDevModeExportAvailable, Converter={StaticResource BoolToVisibility}}"/>
            <Button Content="Load Debug Data File" Command="{Binding LoadFromFileCommand}" Margin="10,0,0,0" Padding="10,2"
                    Visibility="{Binding IsDevModeImportAvailable, Converter={StaticResource BoolToVisibility}}"/>
            <Button Content="Load Project" Command="{Binding LoadProjectCommand}" Margin="20,0,0,0" Padding="10,2"
                    Visibility="{Binding IsProjectStoreAvailable, Converter={StaticResource BoolToVisibility}}"/>
            <Button Content="Export Airport XML" Command="{Binding ExportXmlCommand}" Margin="10,0,0,0" Padding="10,2"
                    Visibility="{Binding IsXmlExportAvailable, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding LastExportPath, StringFormat='Saved to: {0}'}" Margin="0,4,0,0"
                    Visibility="{Binding IsDevModeExportAvailable, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Grid.Row="2" Text="{Binding LastXmlExportPath, StringFormat='Airport XML exported to: {0}'}" Margin="0,4,0,0"
                    Visibility="{Binding IsXmlExportAvailable, Converter={StaticResource BoolToVisibility}}"/>
        <StackPanel Grid.Row="2" Margin="0,22,0,0"
                    Visibility="{Binding LastXmlExportWarnings.Count, Converter={StaticResource CountToVisibility}}">
            <TextBlock Foreground="DarkOrange" Text="{Binding LastXmlExportWarnings.Count, StringFormat='Export warnings ({0}):'}"/>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                <TextBlock Foreground="DarkOrange" TextWrapping="Wrap"
                           Text="{Binding LastXmlExportWarnings, Converter={StaticResource StringListToNewlines}, Mode=OneWay}"/>
            </ScrollViewer>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TabControl Grid.Row="4" Margin="0,10,0,0" DataContext="{Binding Airport}">
            <TabItem Header="Overview">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Icao}"/>
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Lat/Lon: "/><Run Text="{Binding Latitude, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Longitude, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock><Run Text="Elevation (m): "/><Run Text="{Binding ElevationMeters, Mode=OneWay}"/></TextBlock>
                    <TextBlock><Run Text="Magnetic variation (deg): "/><Run Text="{Binding MagneticVariationDeg, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </TabItem>
            <TabItem Header="Runways">
                <DataGrid ItemsSource="{Binding Runways}" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
            </TabItem>
            <TabItem Header="Frequencies">
                <DataGrid ItemsSource="{Binding Frequencies}" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
            </TabItem>
            <TabItem Header="Parking">
                <DataGrid ItemsSource="{Binding ParkingSpots}" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
            </TabItem>
            <TabItem Header="Taxi Paths">
                <DataGrid ItemsSource="{Binding TaxiPaths}" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
            </TabItem>
            <TabItem Header="Jetways">
                <DataGrid ItemsSource="{Binding Jetways}" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
            </TabItem>
            <TabItem Header="Diagram">
                <controls:AirportDiagramView Margin="10"
                                             DataContext="{Binding DataContext.Diagram, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>
            <TabItem Header="Airport Data">
                <!-- Raw, expandable dump of every field on the loaded AirportDetails
                     (see AirportDataTreeBuilder) — a leaf's Children is empty, which
                     WPF's TreeView already renders as a non-expandable row with no
                     arrow, so leaves and composites need no separate styling. -->
                <TreeView Margin="10"
                          ItemsSource="{Binding DataContext.AirportDataTree, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type inspector:DataNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Text}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </TabItem>
            <TabItem Header="Edit">
                <!-- Taxi path naming/lighting and runway lighting (edge lights,
                     VASI/PAPI, approach lights) editing, backed by
                     MainViewModel.TaxiPathEdits/RunwayEdits — see
                     TaxiPathEditViewModel/RunwayEditViewModel. Edits write straight
                     into the loaded Airport; Save Project persists it via
                     IAirportProjectStore. The diagram on the right (a second,
                     independent AirportDiagramView instance — see its own
                     TaxiwayClickCommand/TaxiwayClearSelectionCommand/
                     TaxiwayContextMenuCommand doc comments) gives spatial context
                     for which taxi path is which and drives the Taxi Paths grid's
                     filtering: click one or more taxiways there (Ctrl+click to
                     extend the selection) to filter the grid below down to just
                     the selected path(s) — a plain click on empty diagram space
                     clears the selection, showing every path again. Right-click
                     the diagram with a selection active to open a popover and
                     batch-edit the selected path(s)' name/lighting together. -->
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Save Project"
                                        Command="{Binding DataContext.SaveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,2"
                                        Visibility="{Binding DataContext.IsProjectStoreAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding DataContext.LastProjectSavePath, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Saved to: {0}'}"/>
                            </StackPanel>

                            <!-- The shared, user-managed name list every taxi path's Name
                                 picker (below) draws from — see TaxiName.cs/TaxiNameEditViewModel.
                                 Renaming here is instantly reflected wherever that name is used
                                 (the diagram, the picker below) since both resolve it live by Id. -->
                            <TextBlock Text="Taxi Names" FontWeight="Bold" Margin="0,0,0,4"/>
                            <DataGrid Margin="0,0,0,4" MaxHeight="140" AutoGenerateColumns="False" CanUserAddRows="False"
                                      ItemsSource="{Binding DataContext.TaxiNames, RelativeSource={RelativeSource AncestorType=Window}}">
                                <DataGrid.Columns>
                                    <!-- A single always-editable TextBox, not a CellTemplate/
                                         CellEditingTemplate split — a DataGridTemplateColumn's
                                         CellEditingTemplate only activates on a SECOND click/interaction
                                         once the cell is already "current," the same well-known WPF
                                         quirk the checkbox columns elsewhere in this file already work
                                         around (see their own comment) by using a real, always-interactive
                                         control directly in CellTemplate — reported directly: clicking a
                                         freshly-added row needed three clicks before typing actually
                                         worked. A blank Value is a real, often heavily-shared sim entry
                                         (e.g. paths to parking) — the "(no name)" watermark behind the
                                         (transparent-background) TextBox shows through whenever Value is
                                         empty, so it still doesn't look like an empty/junk row, per user
                                         feedback after a blank entry was renamed without realizing how
                                         many paths pointed at it; IsHitTestVisible="False" lets a click on
                                         the watermark itself still reach the TextBox underneath. -->
                                    <DataGridTemplateColumn Header="Name" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="(no name)" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center"
                                                               IsHitTestVisible="False"
                                                               Visibility="{Binding IsUnnamed, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Padding="6,1"
                                                        Command="{Binding DataContext.DeleteTaxiNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Add Name" HorizontalAlignment="Left" Margin="0,0,0,14" Padding="10,2"
                                    Command="{Binding DataContext.AddTaxiNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Taxi Paths" FontWeight="Bold" VerticalAlignment="Center"/>
                                <!-- Every column below has its own filter, entered right in that
                                     column's header (see MainViewModel.TaxiPathFilter/
                                     MatchesTaxiPathFilter) — this just resets all of them at once,
                                     since clearing 13 individual filters by hand would be tedious.
                                     Only enabled while at least one is actually set. -->
                                <Button Content="Clear Filters" Margin="12,0,0,0" Padding="8,1"
                                        Command="{Binding DataContext.ClearTaxiPathFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <!-- Bound to VisibleTaxiPathEdits, not TaxiPathEdits — a diagram click
                                 filters this down to just the clicked path(s); with nothing selected on
                                 the diagram it shows every path. Each column's own filter (typed/picked
                                 in its header, below the column label) narrows this further — the two
                                 combine, neither replaces the other (see
                                 MainViewModel.RefreshTaxiwayFilter). Selecting one or more rows here
                                 (independent of that filtering) also highlights the matching
                                 taxiway(s) in the diagram for spatial context — see SelectionChanged's
                                 code-behind handler and MainViewModel.SyncTaxiwaySelectionFromRows.
                                 Deliberately doesn't open the batch-edit popover — that only opens via
                                 a right-click on the diagram (see
                                 ShowTaxiwayBatchEditPopover/OpenTaxiwayBatchEditCommand). CanUserSortColumns=False
                                 — every column header now hosts an interactive filter control, and
                                 WPF's default click-to-sort on the header would otherwise fight with
                                 clicking into one of those to type/pick a filter value. Each filter
                                 header's own StackPanel sets its DataContext explicitly on Loaded (see
                                 MainWindow.xaml.cs's TaxiPathFilterHeader_Loaded) rather than binding
                                 through the usual RelativeSource AncestorType=Window pattern this file
                                 uses everywhere else — confirmed the hard way that DataGridColumn.Header
                                 content doesn't reliably participate in the normal visual-tree
                                 RelativeSource walk (a header TextBox happily showed typed text locally,
                                 but the bound TaxiPathFilter property it was supposed to update never
                                 actually changed; routing through the DataGrid's own Tag instead of
                                 Window didn't fix it either), unlike a plain sibling control (e.g. the
                                 Taxiway Points grid's "Hide All from Diagram" checkbox). Each header's
                                 filter controls below bind directly (e.g. {Binding NameFilter}) against
                                 that explicitly-set DataContext. -->
                            <DataGrid x:Name="TaxiPathsGrid" Margin="0,0,0,14" MaxHeight="220" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TaxiPathsGrid_SelectionChanged"
                                      ItemsSource="{Binding DataContext.VisibleTaxiPathEdits, RelativeSource={RelativeSource AncestorType=Window}}">
                                <DataGrid.Columns>
                                    <!-- DataGridCheckBoxColumn's rendered checkbox isn't interactive
                                         until its cell becomes "current" (selected) — a well-known WPF
                                         quirk that makes every checkbox need a first click just to
                                         select the cell and a second to actually toggle it. A real
                                         CheckBox in a DataGridTemplateColumn's CellTemplate is always
                                         interactive, so it toggles on the first click. -->
                                    <DataGridTemplateColumn Width="120">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Hide from Diagram" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.BoolFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding HiddenFromDiagramFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsHiddenFromDiagram, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="150">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Name"/>
                                                <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Bound to TaxiNamesPicker, NOT TaxiNames directly — see
                                                     MainViewModel.TaxiNamesPicker's own doc comment: sharing
                                                     the Taxi Names grid's own collection instance across
                                                     every one of these ComboBoxes (one per row, up to
                                                     hundreds) crashed the app with an
                                                     InvalidOperationException the moment a Taxi Names row was
                                                     being edited while any of these re-attached. -->
                                                <ComboBox ItemsSource="{Binding DataContext.TaxiNamesPicker, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="DisplayValue" SelectedValuePath="Id"
                                                          SelectedValue="{Binding TaxiNameId, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Read-only — the sim's own TAXI_POINT indices this path connects
                                         (see TaxiPathEditViewModel.StartIndex/EndIndex), cross-referenced
                                         against the Taxiway Points grid/diagram dots below by this same
                                         index. -->
                                    <DataGridTextColumn Width="55" IsReadOnly="True" Binding="{Binding StartIndex}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Start"/>
                                                <TextBox Text="{Binding StartIndexFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="55" IsReadOnly="True" Binding="{Binding EndIndex}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="End"/>
                                                <TextBox Text="{Binding EndIndexFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="90">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Type"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPathTypesFilter}"
                                                          SelectedItem="{Binding TypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPathTypes}"
                                                          SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="55" Binding="{Binding RunwayNumber, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Rwy #"/>
                                                <TextBox Text="{Binding RunwayNumberFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="110">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Rwy Designator" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPathRunwayDesignatorsFilter}"
                                                          SelectedItem="{Binding RunwayDesignatorFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPathRunwayDesignators}"
                                                          SelectedItem="{Binding RunwayDesignator, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="95">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Left Edge"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiEdgeTypesFilter}"
                                                          SelectedItem="{Binding LeftEdgeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiEdgeTypes}"
                                                          SelectedItem="{Binding LeftEdge, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="120">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Left Edge Lighted" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.BoolFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding LeftEdgeLightedFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding LeftEdgeLighted, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="95">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Right Edge"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiEdgeTypesFilter}"
                                                          SelectedItem="{Binding RightEdgeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiEdgeTypes}"
                                                          SelectedItem="{Binding RightEdge, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="120">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Right Edge Lighted" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.BoolFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding RightEdgeLightedFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding RightEdgeLighted, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="90">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Center Line"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.BoolFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding CenterLineFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding CenterLine, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="125">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Loaded="TaxiPathFilterHeader_Loaded">
                                                <TextBlock Text="Center Line Lighted" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.BoolFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding CenterLineLightedFilter, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="Normal" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding CenterLineLighted, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Taxiway Points" FontWeight="Bold" VerticalAlignment="Center"/>
                                <!-- A single all-or-nothing toggle, not a per-row checkbox like
                                     TaxiPathEdits/RunwayEdits' "Hide from Diagram" column — there can be
                                     hundreds of points, so a per-row control would be impractical for
                                     decluttering. See MainViewModel.HideAllTaxiwayPoints. -->
                                <CheckBox Content="Hide All from Diagram" Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding DataContext.HideAllTaxiwayPoints, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- Bound to VisibleTaxiwayPointEdits, not TaxiwayPointEdits — a diagram
                                 click on one or more red dots (Ctrl+click to extend the selection,
                                 same as a taxiway path) filters this down to just the clicked
                                 point(s); with nothing selected it shows every point (see
                                 MainViewModel.RefreshTaxiwayPointFilter). One row per distinct sim
                                 TAXI_POINT index resolved from Airport.TaxiPaths (see
                                 TaxiwayPointEditViewModel.BuildAll). Index/X/Z are read-only (derived
                                 from the underlying taxi path data, not independently editable);
                                 Type/Orientation write through to every taxi path segment sharing that
                                 point. -->
                            <DataGrid Margin="0,0,0,14" MaxHeight="220" AutoGenerateColumns="False" CanUserAddRows="False"
                                      ItemsSource="{Binding DataContext.VisibleTaxiwayPointEdits, RelativeSource={RelativeSource AncestorType=Window}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Index" Width="50" IsReadOnly="True" Binding="{Binding Index}"/>
                                    <DataGridTextColumn Header="X (m)" Width="70" IsReadOnly="True" Binding="{Binding XMeters}"/>
                                    <DataGridTextColumn Header="Z (m)" Width="70" IsReadOnly="True" Binding="{Binding ZMeters}"/>
                                    <DataGridTemplateColumn Header="Type" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPointTypes}"
                                                          SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Orientation" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static helpers:EnumOptions.TaxiPointOrientations}"
                                                          SelectedItem="{Binding Orientation, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                    <TextBlock Text="Runways" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                              ItemsSource="{Binding DataContext.RunwayEdits, RelativeSource={RelativeSource AncestorType=Window}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Hide from Diagram" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsHiddenFromDiagram, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Primary" Width="55" IsReadOnly="True" Binding="{Binding PrimaryDesignation}"/>
                            <DataGridTextColumn Header="Secondary" Width="65" IsReadOnly="True" Binding="{Binding SecondaryDesignation}"/>
                            <DataGridTemplateColumn Header="Edge Lights" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static helpers:EnumOptions.RunwayLightIntensities}"
                                                  SelectedItem="{Binding EdgeLightIntensity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Pri L VASI" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
