                            <DataGridTemplateColumn Header="Pri Approach Lights" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static helpers:EnumOptions.ApproachLightSystemTypes}"
                                                  SelectedItem="{Binding PrimarySystemType, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Sec Approach Lights" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static helpers:EnumOptions.ApproachLightSystemTypes}"
