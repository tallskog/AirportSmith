<UserControl x:Class="AirportSmith.Controls.AirportDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseWheel="OnMouseWheel"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseRightButtonDown="OnMouseRightButtonDown"
             MouseMove="OnMouseMove"
             LostMouseCapture="OnLostMouseCapture">

    <!-- Per FAA AIM 2-3-3 (see requirements.md's reference list): a displaced
         threshold's markings are WHITE (still usable runway pavement, just
         not for landing); a blast pad/overrun's demarcation bar and chevrons
         are YELLOW (pavement unusable for landing/takeoff/taxi) — its
         background fill is SlateGray (lighter than the runway's
         DarkSlateGray) per user request, so it reads as related pavement
         while staying visually distinct from the runway itself, rather than
         AIM's own (also-yellow) background. Shared as keyed templates since
         each applies to both the primary and secondary end. -->
    <UserControl.Resources>
        <DataTemplate x:Key="RunwayThresholdMarkingTemplate">
            <Canvas>
                <Polygon Points="{Binding ZoneCorners, Converter={StaticResource Point2DListToPointCollection}}" Fill="#66FFFFFF"/>
                <Polygon Points="{Binding ThresholdBar, Converter={StaticResource Point2DListToPointCollection}}" Fill="White"/>
                <Line X1="{Binding ArrowShaftStart.X}" Y1="{Binding ArrowShaftStart.Y}" X2="{Binding ArrowShaftEnd.X}" Y2="{Binding ArrowShaftEnd.Y}" Stroke="White" StrokeThickness="2"/>
                <Polygon Points="{Binding ArrowHead, Converter={StaticResource Point2DListToPointCollection}}" Fill="White"/>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="RunwayExtensionTemplate">
            <Canvas>
                <!-- Background is SlateGray — close to the runway's own
                     DarkSlateGray (same pavement family) but light enough to
                     tell apart from it at a glance. The demarcation bar and
                     chevrons still carry AIM 2-3-3's yellow. -->
                <Polygon Points="{Binding Corners, Converter={StaticResource Point2DListToPointCollection}}" Fill="SlateGray"/>
                <Polygon Points="{Binding DemarcationBar, Converter={StaticResource Point2DListToPointCollection}}" Fill="Yellow"/>
                <ItemsControl ItemsSource="{Binding Chevrons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding Converter={StaticResource Point2DListToPointCollection}}" Stroke="Yellow" StrokeThickness="2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </DataTemplate>

        <!-- Per FAA AIM 2-1-3 (see requirements.md's reference list): a
             schematic approach lighting system — a row of rail-light dots
             extending outward from the threshold, plus (for ALSF-1/ALSF-2
             only) a red crossbar for their defining red side-row barrettes /
             decision bar. Real rail lights are white, but the diagram's own
             background (Border Background="White" above) is also white, so
             a white-filled dot is invisible regardless of stroke thickness —
             Gold with a black outline instead, which stays visible against
             the white background at any zoom level.

             A real airport's own taxiway/parking layout can already span
             several kilometers (confirmed against EFHK: ~4900m x 3100m from
             taxi/parking data alone, before the ~730m the approach light
             rail itself adds beyond each runway end) — at that scale,
             fit-to-view shrinks a lone few-meter-wide dot below a device
             pixel regardless of color, so a connecting Polyline is drawn
             through the rail lights first (same reason the thin, long
             taxiway centerlines above stay visible at any zoom — a line's
             length keeps it rendering even when its stroke alone would be
             sub-pixel) and the dots are drawn on top of it for detail once
             zoomed in on a specific runway end. CrossBar is an empty point
             list when absent, so its Polyline simply renders nothing. -->
        <DataTemplate x:Key="ApproachLightsTemplate">
            <Canvas>
                <Polyline Points="{Binding RailLights, Converter={StaticResource Point2DListToPointCollection}}" Stroke="Gold" StrokeThickness="4"/>
                <ItemsControl ItemsSource="{Binding RailLights}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="16" Height="16" Fill="Gold" Stroke="Black" StrokeThickness="1"
                                     Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Margin="-8,-8,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Polyline Points="{Binding CrossBar, Converter={StaticResource Point2DListToPointCollection}}" Stroke="Red" StrokeThickness="8"/>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Border carries the background so empty space around the diagram is
         still hit-testable for pan/zoom, and clips the transformed canvas. -->
    <Border Background="White" ClipToBounds="True">
        <Canvas x:Name="DiagramCanvas"
                Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.RenderTransform>
                <!-- Scale then translate: screen = canvas * scale + translate.
                     AirportDiagramView's zoom/pan math depends on that order. -->
                <TransformGroup>
                    <ScaleTransform x:Name="DiagramScale"/>
                    <TranslateTransform x:Name="DiagramTranslate"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <ItemsControl ItemsSource="{Binding Runways}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- IsVisible backs the Edit tab's per-row "hide from diagram" toggle — see
                             the equivalent comment on the taxiway template below. -->
                        <Canvas Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                            <!-- Blast pad / overrun: extra pavement extending outward beyond each
                                 threshold. Drawn first (bottom layer) — a null feature (ContentControl
                                 Content unset) simply renders nothing. -->
                            <ContentControl Content="{Binding PrimaryFeatures.BlastPad}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding PrimaryFeatures.Overrun}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.BlastPad}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.Overrun}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>

                            <!-- Approach lights extend outward beyond the extensions above, so they
                                 stay furthest from the runway itself and never get drawn over by them. -->
                            <ContentControl Content="{Binding PrimaryFeatures.ApproachLights}" ContentTemplate="{StaticResource ApproachLightsTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.ApproachLights}" ContentTemplate="{StaticResource ApproachLightsTemplate}"/>

                            <Polygon Points="{Binding Corners, Converter={StaticResource Point2DListToPointCollection}}" Fill="DarkSlateGray"/>

                            <!-- Displaced threshold: a marking WITHIN the runway's own pavement,
                                 drawn after (on top of) the runway polygon above. -->
                            <ContentControl Content="{Binding PrimaryFeatures.ThresholdMarking}" ContentTemplate="{StaticResource RunwayThresholdMarkingTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.ThresholdMarking}" ContentTemplate="{StaticResource RunwayThresholdMarkingTemplate}"/>

                            <TextBlock Text="{Binding PrimaryDesignation}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       Canvas.Left="{Binding PrimaryLabelPosition.X}" Canvas.Top="{Binding PrimaryLabelPosition.Y}"
                                       Margin="-12,-8,0,0"/>
                            <TextBlock Text="{Binding SecondaryDesignation}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       Canvas.Left="{Binding SecondaryLabelPosition.X}" Canvas.Top="{Binding SecondaryLabelPosition.Y}"
                                       Margin="-12,-8,0,0"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drawn AFTER Runways (unlike before IsRunwayType existed, when draw order
                 relative to Runways never mattered since ordinary taxiways don't overlap
                 runway pavement) — confirmed the hard way that a Runway-type segment's red
                 line rendered completely correctly (right position, right color, per a
                 dedicated on-canvas debug marker placed at its exact Start/End) yet stayed
                 totally invisible: it was being drawn UNDER the Runways ItemsControl's own
                 DarkSlateGray pavement Polygon, which paints over anything beneath it
                 wherever a Runway-type path (by definition) runs along/across the runway
                 itself. Moving the whole ItemsControl after Runways fixes this for every
                 segment, not just the ones that happen to overlap a runway. -->
            <ItemsControl ItemsSource="{Binding TaxiwaySegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- IsVisible backs the Edit tab's per-row "hide from diagram" toggle — a
                             workspace convenience (TaxiPathEditViewModel.IsHiddenFromDiagram), not a
                             real airport property. It defaults true and the read-only Diagram tab has
                             no way to change it, so every segment there stays visible as before. -->
                        <Canvas Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                            <!-- Pavement footprint band, sized from TaxiPathSegment.WidthMeters. The
                                 centerline below stays the named/unnamed indicator, unchanged. This is
                                 also the click target for the Edit tab's diagram multi-select (a wider,
                                 friendlier hit area than the thin centerline) — see
                                 TaxiwayShape_MouseLeftButtonDown; the highlight below only ever shows
                                 IsSelected=true when that's wired up (the read-only Diagram tab never
                                 sets it). -->
                            <Polygon Points="{Binding WidthCorners, Converter={StaticResource Point2DListToPointCollection}}"
                                     MouseLeftButtonDown="TaxiwayShape_MouseLeftButtonDown">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="Fill" Value="#33808080"/>
                                        <Setter Property="Stroke" Value="Gray"/>
                                        <Setter Property="StrokeThickness" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Fill" Value="#55FFA500"/>
                                                <Setter Property="Stroke" Value="Orange"/>
                                                <Setter Property="StrokeThickness" Value="2.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>
                            <!-- IsRunwayType (a TaxiPathType.Runway segment — the taxi path onto/off a
                                 runway, e.g. an entrance/exit stub) always wins over the ordinary
                                 named/unnamed styling below, regardless of HasName, so it reads
                                 unmistakably as "this connects to a runway, not an ordinary taxiway" —
                                 the whole point of drawing these lines at all is to stop a point only
                                 reachable through one from looking like an orphaned dot next to its own
                                 TaxiwayPoints marker (see TaxiwaySegmentShape.IsRunwayType's own doc
                                 comment for the real OIBK anomaly this fixes). -->
                            <!-- StrokeThickness is set entirely via the Style below (not as a local
                                 attribute here) — a local value on the element itself would take
                                 precedence over every Style.Triggers Setter for the same property
                                 regardless of which trigger is active, silently defeating
                                 IsRunwayType's own thicker override below. -->
                            <Line X1="{Binding Start.X}" Y1="{Binding Start.Y}" X2="{Binding End.X}" Y2="{Binding End.Y}">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="Stroke" Value="Gray"/>
                                        <Setter Property="StrokeDashArray" Value="4,2"/>
                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasName}" Value="True">
                                                <Setter Property="Stroke" Value="Blue"/>
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <!-- Thicker than every other line style in this view (the
                                                 approach-lights rail's own connecting Polyline is 4) so a
                                                 Runway-type segment stays visible even across the long spans
                                                 some of OIBK's real data has (995m in one case) at a large
                                                 airport's fit-to-view zoom — same "shrinks below a device
                                                 pixel" concern already documented for the approach lights
                                                 rail and the taxiway point markers. -->
                                            <DataTrigger Binding="{Binding IsRunwayType}" Value="True">
                                                <Setter Property="Stroke" Value="Red"/>
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                                <Setter Property="StrokeThickness" Value="5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="DarkBlue" Background="White"
                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}"
                                       Canvas.Left="{Binding MidPoint.X}" Canvas.Top="{Binding MidPoint.Y}"
                                       Margin="-10,-16,0,0"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ParkingSpots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Stroke="Orange" StrokeThickness="1" Fill="#33FFA500">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="{Binding Center, Converter={StaticResource Point2DToPoint}}" RadiusX="{Binding RadiusMeters}" RadiusY="{Binding RadiusMeters}"/>
                                    <LineGeometry StartPoint="{Binding Center, Converter={StaticResource Point2DToPoint}}" EndPoint="{Binding HeadingTip, Converter={StaticResource Point2DToPoint}}"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Each distinct sim TAXI_POINT index resolved from the airport's taxi
                 paths (see AirportDiagramProjector.Project's TaxiwayPoints), drawn last
                 so they stay visible on top of every other shape. Uses a Path +
                 EllipseGeometry with an absolute Center (same mechanism as ParkingSpots
                 just above), not Canvas.Left/Top on the template root like every other
                 marker in this view — that Canvas.Left/Top-on-template-root approach
                 (which works fine for every OTHER templated item in this file) was tried
                 first here and confirmed broken specifically for this ItemsControl
                 against a real loaded airport: every one of the 381 generated items
                 rendered stacked at the same (0,0)-ish spot instead of its own Center,
                 root cause not identified. EllipseGeometry.Center draws in the geometry's
                 own absolute coordinate space regardless of the hosting Path's own
                 Canvas position, sidestepping whatever that Canvas.Left issue was —
                 confirmed fixed against the same real airport.

                 IsVisible backs both the per-shape state driven by "Hide All Taxiway
                 Points from Diagram" (MainViewModel.HideAllTaxiwayPoints — a single
                 all-or-nothing toggle, unlike TaxiwaySegments/Runways' per-row
                 checkboxes, since individual points don't have their own Edit tab
                 checkbox) and the read-only Diagram tab, which never sets it, so points
                 stay visible there. IsSelected is the Edit tab's click-to-select
                 highlight — Ctrl+click extends the selection, same as a taxiway path
                 (see TaxiwayPointShape_MouseLeftButtonDown/
                 MainViewModel.ToggleTaxiwayPointSelection) — filtering the Taxiway
                 Points grid down to just the selected point(s). -->
            <ItemsControl ItemsSource="{Binding TaxiwayPoints}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Stroke="Black" StrokeThickness="1"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                              MouseLeftButtonDown="TaxiwayPointShape_MouseLeftButtonDown">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Fill" Value="Orange"/>
                                            <Setter Property="Stroke" Value="DarkOrange"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                            <Path.Data>
                                <EllipseGeometry Center="{Binding Center, Converter={StaticResource Point2DToPoint}}" RadiusX="9" RadiusY="9"/>
                            </Path.Data>
                        </Path>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Border>
</UserControl>
