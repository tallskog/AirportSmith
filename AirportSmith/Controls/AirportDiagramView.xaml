<UserControl x:Class="AirportSmith.Controls.AirportDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseWheel="OnMouseWheel"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseMove="OnMouseMove"
             LostMouseCapture="OnLostMouseCapture">

    <!-- Per FAA AIM 2-3-3 (see requirements.md's reference list): a displaced
         threshold's markings are WHITE (still usable runway pavement, just
         not for landing); a blast pad/overrun's demarcation bar and chevrons
         are YELLOW (pavement unusable for landing/takeoff/taxi) — its
         background fill is SlateGray (lighter than the runway's
         DarkSlateGray) per user request, so it reads as related pavement
         while staying visually distinct from the runway itself, rather than
         AIM's own (also-yellow) background. Shared as keyed templates since
         each applies to both the primary and secondary end. -->
    <UserControl.Resources>
        <DataTemplate x:Key="RunwayThresholdMarkingTemplate">
            <Canvas>
                <Polygon Points="{Binding ZoneCorners, Converter={StaticResource Point2DListToPointCollection}}" Fill="#66FFFFFF"/>
                <Polygon Points="{Binding ThresholdBar, Converter={StaticResource Point2DListToPointCollection}}" Fill="White"/>
                <Line X1="{Binding ArrowShaftStart.X}" Y1="{Binding ArrowShaftStart.Y}" X2="{Binding ArrowShaftEnd.X}" Y2="{Binding ArrowShaftEnd.Y}" Stroke="White" StrokeThickness="2"/>
                <Polygon Points="{Binding ArrowHead, Converter={StaticResource Point2DListToPointCollection}}" Fill="White"/>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="RunwayExtensionTemplate">
            <Canvas>
                <!-- Background is SlateGray — close to the runway's own
                     DarkSlateGray (same pavement family) but light enough to
                     tell apart from it at a glance. The demarcation bar and
                     chevrons still carry AIM 2-3-3's yellow. -->
                <Polygon Points="{Binding Corners, Converter={StaticResource Point2DListToPointCollection}}" Fill="SlateGray"/>
                <Polygon Points="{Binding DemarcationBar, Converter={StaticResource Point2DListToPointCollection}}" Fill="Yellow"/>
                <ItemsControl ItemsSource="{Binding Chevrons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding Converter={StaticResource Point2DListToPointCollection}}" Stroke="Yellow" StrokeThickness="2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Border carries the background so empty space around the diagram is
         still hit-testable for pan/zoom, and clips the transformed canvas. -->
    <Border Background="White" ClipToBounds="True">
        <Canvas x:Name="DiagramCanvas"
                Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.RenderTransform>
                <!-- Scale then translate: screen = canvas * scale + translate.
                     AirportDiagramView's zoom/pan math depends on that order. -->
                <TransformGroup>
                    <ScaleTransform x:Name="DiagramScale"/>
                    <TranslateTransform x:Name="DiagramTranslate"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <ItemsControl ItemsSource="{Binding TaxiwaySegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <!-- Pavement footprint band, sized from TaxiPathSegment.WidthMeters. The
                                 centerline below stays the named/unnamed indicator, unchanged. -->
                            <Polygon Points="{Binding WidthCorners, Converter={StaticResource Point2DListToPointCollection}}"
                                     Fill="#33808080" Stroke="Gray" StrokeThickness="0.5"/>
                            <Line X1="{Binding Start.X}" Y1="{Binding Start.Y}" X2="{Binding End.X}" Y2="{Binding End.Y}" StrokeThickness="1.5">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="Stroke" Value="Gray"/>
                                        <Setter Property="StrokeDashArray" Value="4,2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasName}" Value="True">
                                                <Setter Property="Stroke" Value="Blue"/>
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="DarkBlue" Background="White"
                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}"
                                       Canvas.Left="{Binding MidPoint.X}" Canvas.Top="{Binding MidPoint.Y}"
                                       Margin="-10,-16,0,0"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Runways}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <!-- Blast pad / overrun: extra pavement extending outward beyond each
                                 threshold. Drawn first (bottom layer) — a null feature (ContentControl
                                 Content unset) simply renders nothing. -->
                            <ContentControl Content="{Binding PrimaryFeatures.BlastPad}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding PrimaryFeatures.Overrun}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.BlastPad}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.Overrun}" ContentTemplate="{StaticResource RunwayExtensionTemplate}"/>

                            <Polygon Points="{Binding Corners, Converter={StaticResource Point2DListToPointCollection}}" Fill="DarkSlateGray"/>

                            <!-- Displaced threshold: a marking WITHIN the runway's own pavement,
                                 drawn after (on top of) the runway polygon above. -->
                            <ContentControl Content="{Binding PrimaryFeatures.ThresholdMarking}" ContentTemplate="{StaticResource RunwayThresholdMarkingTemplate}"/>
                            <ContentControl Content="{Binding SecondaryFeatures.ThresholdMarking}" ContentTemplate="{StaticResource RunwayThresholdMarkingTemplate}"/>

                            <TextBlock Text="{Binding PrimaryDesignation}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       Canvas.Left="{Binding PrimaryLabelPosition.X}" Canvas.Top="{Binding PrimaryLabelPosition.Y}"
                                       Margin="-12,-8,0,0"/>
                            <TextBlock Text="{Binding SecondaryDesignation}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       Canvas.Left="{Binding SecondaryLabelPosition.X}" Canvas.Top="{Binding SecondaryLabelPosition.Y}"
                                       Margin="-12,-8,0,0"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ParkingSpots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Stroke="Orange" StrokeThickness="1" Fill="#33FFA500">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="{Binding Center, Converter={StaticResource Point2DToPoint}}" RadiusX="{Binding RadiusMeters}" RadiusY="{Binding RadiusMeters}"/>
                                    <LineGeometry StartPoint="{Binding Center, Converter={StaticResource Point2DToPoint}}" EndPoint="{Binding HeadingTip, Converter={StaticResource Point2DToPoint}}"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Border>
</UserControl>
