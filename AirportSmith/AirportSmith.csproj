<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.0.3</Version>
    <ApplicationIcon>AirportSmith.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AirportSmith.ico" />
    <Resource Include="AirportSmith.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed SimConnect wrapper (x64, .NET Framework 4.6.1 — loads via compat layer) -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>Libs\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <!-- Explicit copy targets because WPF SDK projects don't reliably process
       CopyToOutputDirectory on None/Content items for native DLLs. -->
  <Target Name="CopySimConnectNative" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)Libs\SimConnect.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySimConnectNativePublish" AfterTargets="Publish">
    <Copy SourceFiles="$(ProjectDir)Libs\SimConnect.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
